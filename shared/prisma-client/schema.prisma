// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../../shared/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum User_Role {
  owner
  tenant
  building_security
  building_manager
  admin
  visitor
}

model PreSignUpManagement {
  email          String   @unique
  company_name   String
  contact_number String
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now())

  @@map("PreSignUpManagements")
}

enum Verification_Status {
  not_started
  completed
  failed
}

enum Mobile_Onboard_Status {
  not_started
  completed
}

model User {
  id                    String                 @id @unique @default(uuid())
  email                 String?                @unique
  phone_number          String?                @unique
  first_name            String?
  last_name             String?
  user_roles            User_Role[]            @default([])
  verification_status   Verification_Status?   @default(not_started)
  mobile_onboard_status Mobile_Onboard_Status? @default(not_started)

  created_at DateTime @default(now())
  last_login DateTime @default(now())

  management          Management? // Relation field
  community_members   CommunityMembers[] // Relation field
  // invite_codes InviteCode[] // Relation field
  listings            Listing[]
  hostReservations    Reservation[]      @relation(name: "HostRelation")
  visitorReservations Reservation[]      @relation(name: "VisitorRelation")

  @@map("Users")
}

enum Subscription_PlanType {
  basic
  standard
  pro
}

enum Active_State {
  active
  inactive
}

enum OnboardingState {
  management_onboard
  building_onboard
  payment
  finish
}

model Management {
  id                     String                 @id @unique @default(uuid())
  user_id                String                 @unique
  company_name           String?
  business_email         String?                @unique
  phone_number           String?
  customer_service_email String?
  emergency_email        String?
  address                String?
  address2               String?
  lat                    Float?
  lng                    Float?
  subscription_plan_type Subscription_PlanType?
  subscription_state     Active_State?
  business_state         Active_State?
  date_joined            DateTime               @default(now())
  last_login             DateTime               @default(now())
  last_updated           DateTime               @default(now()) @updatedAt
  onboard_state          OnboardingState?       @default(management_onboard)

  staffs    ManagementStaff[] // Relation field
  buildings Building[] // Relation field

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade) // Relation attribute
}

model ManagementStaff {
  id            String   @id @unique @default(uuid())
  management_id String // Foreign key field
  name          String?
  email         String?  @unique
  date_added    DateTime @default(now())
  last_updated  DateTime @default(now()) @updatedAt

  management Management @relation(fields: [management_id], references: [id], onDelete: Cascade) // Relation attribute
}

enum BuildingType {
  commercial
  residential
  governmental
}

enum BuildingFacility {
  ev_charging
  bulk_parking_owners
  smart_meters
  anpr
  internet_wifi
  access_card_system
  visitor_parking
  bms
  handicapped_parking
  paid_parking_system
}

model Building {
  id                            String             @id @unique @default(uuid())
  management_id                 String // Foreign key field
  building_name                 String?
  building_type                 BuildingType?
  address                       String?
  city                          String?
  state                         String?
  country                       String?
  lat                           Float?
  lng                           Float?
  no_of_units                   Int?
  no_of_parking_floors          Int?
  no_of_parking_spots           Int?
  no_of_developer_parking_spots Int?
  facilities                    BuildingFacility[]

  management        Management         @relation(fields: [management_id], references: [id], onDelete: Cascade) // Relation attribute
  community_members CommunityMembers[] // Relation field
  parking_spots     ParkingSpot[] // Relation field
  reservations       Reservation[]
}

model CommunityMembers {
  id           String       @id @unique @default(uuid())
  building_id  String // Foreign key
  user_id      String? // Foreign key
  user_role    User_Role?
  email        String?
  name         String?
  phone        String?
  unit_numbers String[]     @default([])
  status       Active_State @default(inactive)

  qr_code_id String? @unique

  building      Building      @relation(fields: [building_id], references: [id], onDelete: Cascade) // Relation attribute
  qr_code       QRCode?       @relation(fields: [qr_code_id], references: [id], onDelete: Cascade) // Relation attribute
  parking_spots ParkingSpot[] // A community member can have multiple parking spots
  user          User?         @relation(fields: [user_id], references: [id]) // Relation attribute

  @@unique([building_id, phone, email])
}

enum Parking_Spot_Type {
  regular
  electric
}

model ParkingSpot {
  id          String  @id @unique @default(uuid())
  building_id String // Foreign key
  owner_id    String? // Foreign key
  qr_code_id  String? @unique
  vehicle_id  String? // Foreign key

  parking_level        Int?
  parking_spot_number  String?
  parking_spot_type    Parking_Spot_Type @default(regular)
  parking_instructions String?           @default("")

  building    Building          @relation(fields: [building_id], references: [id], onDelete: Cascade) // Relation attribute
  owner       CommunityMembers? @relation(fields: [owner_id], references: [id], onDelete: Cascade) // Relation attribute
  qr_code     QRCode?           @relation(fields: [qr_code_id], references: [id], onDelete: Cascade) // Relation attribute
  vehicle     Vehicle?          @relation(fields: [vehicle_id], references: [id], onDelete: Cascade) // Relation attribute
  listings     Listing[]
  reservations Reservation[]

  @@unique([qr_code_id, parking_level, parking_spot_number]) // Ensure a parking spot can only have one QR code
}

enum QRCode_Type {
  static
  dynamic
}

enum QRCode_For {
  community_member
  parking_spot
}

model QRCode {
  id        String      @id @unique
  qr_type   QRCode_Type
  url       String
  image_url String?

  qr_for QRCode_For

  owner        CommunityMembers?
  parking_spot ParkingSpot?
}

enum Vehicle_Type {
  regular
  electric
  hybrid
}

model Vehicle {
  id String @id @unique @default(uuid())

  vehicle_plate String?
  vehicle_type  Vehicle_Type @default(regular)

  parking_spots ParkingSpot[]
}

enum Listing_Type {
  hourly
  weekly
  monthly
}

enum Confirmation_Type {
  manual
  automatic
}

model Listing {
  id                String            @id @unique @default(uuid())
  host_id           String // Foreign key
  parking_id        String // Foreign key
  title             String?
  description       String?
  type              Listing_Type?
  price             Int? // In cents
  status            Active_State      @default(active)
  booking_status    Active_State      @default(inactive)
  confirmation_type Confirmation_Type @default(automatic)
  no_of_bookings    Int?              @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  host         User          @relation(fields: [host_id], references: [id], onDelete: Cascade) // Relation attribute
  parking_spot ParkingSpot   @relation(fields: [parking_id], references: [id], onDelete: Cascade) // Relation attribute
  reservations  Reservation[]

  @@unique([host_id, parking_id])
}

enum Reservation_Status {
  pending
  confirmed
  cancelled
  completed
}

model Reservation {
  id          String   @id @unique @default(uuid())
  listing_id  String
  host_id     String
  visitor_id  String
  building_id String?
  parking_spot_id  String
  price       Int? // In cents
  start_date       DateTime
  end_date         DateTime
  status      Reservation_Status @default(pending)

  listing  Listing     @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  host     User        @relation(name: "HostRelation", fields: [host_id], references: [id], onDelete: Cascade)
  visitor  User        @relation(name: "VisitorRelation", fields: [visitor_id], references: [id], onDelete: Cascade)
  building Building?    @relation(fields: [building_id], references: [id], onDelete: Cascade)
  parking  ParkingSpot @relation(fields: [parking_spot_id], references: [id], onDelete: Cascade)
}

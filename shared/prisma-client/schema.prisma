// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../../shared/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum User_Role {
  owner
  tenant
  building_security
  building_manager
  admin
  visitor
}

model PreSignUpManagement {
  email          String   @unique
  company_name   String
  contact_number String
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now())

  @@map("PreSignUpManagements")
}

enum Verification_Status {
  not_started
  completed
  failed
}

enum Mobile_Onboard_Status {
  not_started
  completed
}

model User {
  id                    String                 @id @unique @default(uuid())
  email                 String?                @unique
  phone_number          String?                @unique
  first_name            String?
  last_name             String?
  user_roles            User_Role[]            @default([])
  verification_status   Verification_Status?   @default(not_started)
  mobile_onboard_status Mobile_Onboard_Status? @default(not_started)
  stripe_customer_id    String?
  stripe_account        Json?
  notification_token    String?

  created_at DateTime @default(now())
  last_login DateTime @default(now())

  management          Management? // Relation field
  community_members   CommunityMembers[] // Relation field
  // invite_codes InviteCode[] // Relation field
  listings            Listing[]
  hostReservations    Reservation[]      @relation(name: "HostRelation")
  visitorReservations Reservation[]      @relation(name: "VisitorRelation")
  subscriber_subscriptions      Subscription[] @relation("SubscriberUser")
  host_subscriptions            Subscription[] @relation("HostUser")

  @@unique([email, phone_number])
  @@map("Users")
}

enum Subscription_PlanType {
  basic
  standard
  pro
}

enum Active_State {
  active
  inactive
}

enum OnboardingState {
  management_onboard
  building_onboard
  payment
  finish
}

model Management {
  id                     String                 @id @unique @default(uuid())
  user_id                String                 @unique
  company_name           String?
  business_email         String?                @unique
  phone_number           String?
  customer_service_email String?
  emergency_email        String?
  address                String?
  address2               String?
  lat                    Float?
  lng                    Float?
  subscription_plan_type Subscription_PlanType?
  subscription_state     Active_State?
  business_state         Active_State?
  date_joined            DateTime               @default(now())
  last_login             DateTime               @default(now())
  last_updated           DateTime               @default(now()) @updatedAt
  onboard_state          OnboardingState?       @default(management_onboard)

  staffs    ManagementStaff[] // Relation field
  buildings Building[] // Relation field

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade) // Relation attribute
}

model ManagementStaff {
  id            String   @id @unique @default(uuid())
  management_id String // Foreign key field
  name          String?
  email         String?  @unique
  date_added    DateTime @default(now())
  last_updated  DateTime @default(now()) @updatedAt

  management Management @relation(fields: [management_id], references: [id], onDelete: Cascade) // Relation attribute
}

enum BuildingType {
  commercial
  residential
  governmental
}

enum BuildingFacility {
  ev_charging
  bulk_parking_owners
  smart_meters
  anpr
  internet_wifi
  access_card_system
  visitor_parking
  bms
  handicapped_parking
  paid_parking_system
}

model Building {
  id                            String             @id @unique @default(uuid())
  management_id                 String // Foreign key field
  building_name                 String?
  building_type                 BuildingType?
  address                       String?
  city                          String?
  state                         String?
  country                       String?
  lat                           Float?
  lng                           Float?
  no_of_units                   Int?
  no_of_parking_floors          Int?
  no_of_parking_spots           Int?
  no_of_developer_parking_spots Int?
  facilities                    BuildingFacility[]

  management        Management         @relation(fields: [management_id], references: [id], onDelete: Cascade) // Relation attribute
  community_members CommunityMembers[] // Relation field
  parking_spots     ParkingSpot[] // Relation field
  reservations      Reservation[]
  apartment_units   ApartmentUnit[]
}

model CommunityMembers {
  id          String       @id @unique @default(uuid())
  building_id String // Foreign key
  user_id     String? // Foreign key
  user_role   User_Role?
  email       String?
  name        String?
  phone       String?
  status      Active_State @default(inactive)

  qr_code_id String?  @unique
  created_at DateTime @default(now())

  building        Building        @relation(fields: [building_id], references: [id], onDelete: Cascade) // Relation attribute
  qr_code         QRCode?         @relation(fields: [qr_code_id], references: [id], onDelete: Cascade) // Relation attribute
  parking_spots   ParkingSpot[] // A community member can have multiple parking spots
  user            User?           @relation(fields: [user_id], references: [id]) // Relation attribute
  apartment_units ApartmentUnit[]

  @@unique([building_id, phone, email])
}

enum Parking_Spot_Type {
  regular
  electric
}

model ParkingSpot {
  id          String  @id @unique @default(uuid())
  building_id String // Foreign key
  owner_id    String? // Foreign key
  qr_code_id  String? @unique
  vehicle_id  String? // Foreign key

  parking_level        Int?
  parking_spot_number  String?
  parking_spot_type    Parking_Spot_Type @default(regular)
  parking_instructions String?           @default("")

  price Int? // In cents
  hourly_price Int? // In cents
  hourly_stripe_price_id String?
  deposit_price Int? // In cents
  deposit_stripe_price_id String?

  stripe_product Json?
  stripe_deposit_product Json?

  deposit_enabled Boolean? @default(true)

  current_subscription_id String? @unique // Foreign key

  building     Building          @relation(fields: [building_id], references: [id], onDelete: Cascade) // Relation attribute
  owner        CommunityMembers? @relation(fields: [owner_id], references: [id]) // Relation attribute
  qr_code      QRCode?           @relation(fields: [qr_code_id], references: [id], onDelete: Cascade) // Relation attribute
  vehicle      Vehicle?          @relation(fields: [vehicle_id], references: [id], onDelete: Cascade) // Relation attribute
  listings     Listing[]
  reservations Reservation[]

  current_subscription Subscription?  @relation(name: "CurrentSubscription", fields: [current_subscription_id], references: [id])
  all_subscriptions    Subscription[]

  @@unique([qr_code_id, parking_level, parking_spot_number]) // Ensure a parking spot can only have one QR code
}

enum QRCode_Type {
  static
  dynamic
}

enum QRCode_For {
  community_member
  parking_spot
}

model QRCode {
  id        String      @id @unique
  qr_type   QRCode_Type
  url       String
  image_url String?

  qr_for QRCode_For

  owner        CommunityMembers?
  parking_spot ParkingSpot?
}

enum Vehicle_Type {
  regular
  electric
  hybrid
}

model Vehicle {
  id String @id @unique @default(uuid())

  vehicle_plate String?
  vehicle_type  Vehicle_Type @default(regular)

  parking_spots ParkingSpot[]
}

enum Listing_Type {
  hourly
  weekly
  monthly
}

enum Confirmation_Type {
  manual
  automatic
}

model Listing {
  id                String            @id @unique @default(uuid())
  host_id           String // Foreign key
  parking_id        String // Foreign key
  title             String?
  description       String?
  type              Listing_Type?
  price             Int? // In cents
  status            Active_State      @default(active)
  booking_status    Active_State      @default(inactive)
  confirmation_type Confirmation_Type @default(automatic)
  no_of_bookings    Int?              @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  host         User          @relation(fields: [host_id], references: [id], onDelete: Cascade) // Relation attribute
  parking_spot ParkingSpot   @relation(fields: [parking_id], references: [id], onDelete: Cascade) // Relation attribute
  reservations Reservation[]

  @@unique([host_id, parking_id])
}

enum Reservation_Status {
  pending
  confirmed
  cancelled
  completed
}

model Reservation {
  id                       String             @id @unique @default(uuid())
  listing_id               String?
  host_id                  String?
  visitor_id               String?
  building_id              String?
  parking_spot_id          String?
  price                    Int? // In cents
  app_fees                 Int? // In cents
  start_date               DateTime?
  end_date                 DateTime?
  status                   Reservation_Status @default(pending)
  stripe_payment_intent_id String?

  charge Json?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  listing  Listing?     @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  host     User?        @relation(name: "HostRelation", fields: [host_id], references: [id], onDelete: Cascade)
  visitor  User?        @relation(name: "VisitorRelation", fields: [visitor_id], references: [id], onDelete: Cascade)
  building Building?    @relation(fields: [building_id], references: [id], onDelete: Cascade)
  parking  ParkingSpot? @relation(fields: [parking_spot_id], references: [id], onDelete: Cascade)
}

model ApartmentUnit {
  id                  String  @id @unique @default(uuid())
  building_id         String // Foreign key
  unit_number         String?
  no_of_bedrooms      Int?
  no_of_baths         Int?
  community_member_id String?

  building         Building          @relation(fields: [building_id], references: [id], onDelete: Cascade)
  community_member CommunityMembers? @relation(fields: [community_member_id], references: [id])

  @@unique([building_id, unit_number])
}

enum Payment_Type {
  subscription
  payment
}
model Subscription {
  id                       String   @id @default(uuid())
  parking_spot_id          String? // Foreign key
  subscriber_user_id       String? // Foreign key
  host_user_id             String? // Foreign key
  subscriber_name          String?
  subscriber_email         String?
  subscriber_phone         String?
  subscriber_licence_plate String?
  subscriber_car_model     String?
  subscriber_office_number String?
  subscriber_driver_licence_number String?
  subscriber_id_card_number String?
  stripe_subscription      Json?
  stripe_payment_intent   Json?
  no_of_hours              Int?
  access_card_number       String?

  created_at               DateTime @default(now())
  updated_at               DateTime @default(now()) @updatedAt

  parking_spot    ParkingSpot? @relation(fields: [parking_spot_id], references: [id])
  subscriber_user               User? @relation("SubscriberUser", fields: [subscriber_user_id], references: [id])
  host_user                     User? @relation("HostUser", fields: [host_user_id], references: [id])

  // This back-relation is implicit; it's here for clarity and must be unique across Subscription.
  parking_spot_current ParkingSpot? @relation(name: "CurrentSubscription")
}
